"use client";
// app/projects/robot/RobotViewer.tsx
// The 3D model of version 1 of the robot (the stationary desk buddy) on its project page (app/projects/robot/page.tsx).
// Everything is laid out in real millimetres: x = left/right, y = up, z = front/back (the face looks along +z).
// Drag to turn it all the way round, click then scroll to zoom, and flip x-ray to see the parts inside.
// Hover (or tap) a part to see what it is. The wheeled version 2 model is saved in backups/2026-11-12-robot-v2-wheels/.

import { useEffect, useRef, useState } from "react";
import * as THREE from "three";
import { OrbitControls } from "three/addons/controls/OrbitControls.js";
import { RoomEnvironment } from "three/addons/environments/RoomEnvironment.js";

// ---- tweak these ----
const SHELL_COLOUR = 0xf3f3ef;   // the printed body (warm white)
const ACCENT_COLOUR = 0x1f5fd9;  // the blue bits (same blue as the logo)
const BASE_COLOUR = 0x2b2d33;    // the lower part of the body (the base piece)
const DARK_COLOUR = 0x1c1d21;    // the feet
const EYE_COLOUR = "#eaf4ff";    // the eyes on the oled
const SPIN_SPEED = 1.1;          // how fast it turns by itself when "spin" is on
const XRAY_GHOST = 0.17;         // in x-ray view, how visible the body stays (0 = gone, 1 = solid)
const XRAY_LINES = 0x30507f;     // in x-ray view, the fine lines round the body's edges
const SHAKE_SECONDS = 1.4;       // how long it wobbles when you press "shake"
const DIZZY_SECONDS = 2.2;       // how long the dizzy eyes last after that
const VIEW_DISTANCE = 470;       // how far away the camera starts, in mm
const DIM_COLOUR = 0x1f5fd9;     // the measuring lines when "dimensions" is on (the site blue)
const DIM_LABEL = "#1f5fd9";     // the writing on their labels
const DIM_DETAIL_COLOUR = 0x86a9ea; // the smaller measurements of each part (a lighter blue)
const DIM_DETAIL_LABEL = "#4f7fd6"; // the writing on their labels

// ---- where things are (mm). Change a number here and the part moves in the model ----
// It's a little character: a big round head with the face, and a small body with the batteries, on two feet.
const WALL = 5;                   // how thick the printed shell is, everywhere. Every part below sits at least this far inside it
// the head: 110 wide x 75 tall x 72 deep. Big enough for the breadboard to stand upright inside it, behind the face, with WALL all round.
// it prints as a front shell (open at the back) and a back cover that's WALL thick. The cover has 4 tabs that reach
// forward into the head, and 4 screws through the sides of the head go into nuts in those tabs
const HEAD = { hw: 55, y0: 49, y1: 124, z0: -39, z1: 33, round: 20 }; // half width, bottom, top, back, front, corner roundness
const FACE_Y = 87;                                    // how high the middle of the face is
// the breadboard, standing upright (85 wide x 55 tall x 9.7 thick), its holes facing the back.
// x0 = its left edge: pushed left so the pico's usb connector (which sticks out 1.5 past it) is flush with the inside of the left wall
const BOARD = { x0: -48.5, y0: 59, y1: 114, z0: -3.7, z1: 6 };
const EAR = { y: 86.5, z: -10, r: 15 };               // the round ears on the sides of the head
// the body: two pieces. The battery base (y0 to split, with the feet) holds the batteries lying flat;
// the upper body (split to y1, with the neck) has a shelf for the motion sensor. 2 screws through the back of the base hold them together
const BODY = { hw: 38, y0: 2, y1: 48, z0: -35, z1: 35, round: 12, split: 30 };
// the screws: six m4 x 16 mm flat head (countersunk, so they sit flush), each into an m4 nut in a printed pocket.
// a nut is 7 mm across its flats, 8.08 across its corners and 3.2 thick. Its pocket is 7.3 across the flats and 3.5 deep,
// always open to one face so the nut can be pushed in, with at least 2 mm of plastic round it everywhere else
const SCREW = { r: 2, head: 4, len: 16, nut: 4.04, nutT: 3.2 };       // shaft radius, head radius, length, nut size (corner to centre), nut thickness
// the 4 tabs on the head's back cover: 2 on each side, against the side walls. y = each one's middle, z = where its screw is
const HEAD_TAB = { ys: [62, 111], h: 12, x0: 38, z0: HEAD.z0 + WALL, z1: -20.5, screwZ: -27, nutX: 40.6 };
// the 2 tabs that hang down from the upper body at the back, inside the battery base. x, y = where each one's screw is.
// y1 = how far up they go: 6 mm past the split, so each one is fused into the upper body's back wall, not just touching it
const BASE_TAB = { xs: [-24, 24], y: 25, hw: 6.5, y0: 19, y1: BODY.split + 6, z0: BODY.z0 + WALL, z1: -21, nutZ: -24.3 };
// the 2 posts on the head's back cover that stop the breadboard sliding backwards: 4 x 4 mm, at the right end of the board
// where nothing is plugged in. x = how far each one's middle is from the board's left edge, ys = their heights
const STANDOFF = { x: 81, ys: [68, 105], hw: 2, gap: 0.3 };
const NECK = { r: 14, y0: 46, y1: 52 };               // the hollow neck the wires run through

const std = (color: number, roughness = 0.6, metalness = 0, extra: THREE.MeshStandardMaterialParameters = {}) =>
  new THREE.MeshStandardMaterial({ color, roughness, metalness, ...extra });

// a box given by its two corners
const bx = (x0: number, x1: number, y0: number, y1: number, z0: number, z1: number, mat: THREE.Material) => {
  const m = new THREE.Mesh(new THREE.BoxGeometry(Math.abs(x1 - x0), Math.abs(y1 - y0), Math.abs(z1 - z0)), mat);
  m.position.set((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2);
  return m;
};
// cylinders lying along x, or standing along y
const cylX = (r: number, x0: number, x1: number, y: number, z: number, mat: THREE.Material, seg = 40) => {
  const m = new THREE.Mesh(new THREE.CylinderGeometry(r, r, Math.abs(x1 - x0), seg), mat);
  m.rotation.z = Math.PI / 2;
  m.position.set((x0 + x1) / 2, y, z);
  return m;
};
const cylZ = (r: number, z0: number, z1: number, x: number, y: number, mat: THREE.Material, seg = 40) => {
  const m = new THREE.Mesh(new THREE.CylinderGeometry(r, r, Math.abs(z1 - z0), seg), mat);
  m.rotation.x = Math.PI / 2;
  m.position.set(x, y, (z0 + z1) / 2);
  return m;
};
const cylY = (r: number, y0: number, y1: number, x: number, z: number, mat: THREE.Material, seg = 40) => {
  const m = new THREE.Mesh(new THREE.CylinderGeometry(r, r, Math.abs(y1 - y0), seg), mat);
  m.position.set(x, (y0 + y1) / 2, z);
  return m;
};
// an outline with its corners rounded off
function roundedShape(pts: [number, number, number?][], r: number) {
  const s = new THREE.Shape();
  const n = pts.length;
  for (let i = 0; i < n; i++) {
    const p = pts[i], a = pts[(i + n - 1) % n], b = pts[(i + 1) % n];
    const la = Math.hypot(a[0] - p[0], a[1] - p[1]), lb = Math.hypot(b[0] - p[0], b[1] - p[1]);
    const k = Math.min(p[2] ?? r, la / 2, lb / 2);
    if (k < 0.01) { if (i === 0) s.moveTo(p[0], p[1]); else s.lineTo(p[0], p[1]); continue; } // a truly sharp corner: one point, no curve
    const inX = p[0] + ((a[0] - p[0]) / la) * k, inY = p[1] + ((a[1] - p[1]) / la) * k;
    const outX = p[0] + ((b[0] - p[0]) / lb) * k, outY = p[1] + ((b[1] - p[1]) / lb) * k;
    if (i === 0) s.moveTo(inX, inY); else s.lineTo(inX, inY);
    s.quadraticCurveTo(p[0], p[1], outX, outY);
  }
  s.closePath();
  return s;
}

// a side profile (z, y) pushed out sideways into a solid, x0 to x1 wide, with softened edges
function extrudeAcross(pts: [number, number, number?][], x0: number, x1: number, round: number, bevel: number) {
  const shape = roundedShape(pts.map(([z, y, r]) => [-z, y, r]), round);
  const g = new THREE.ExtrudeGeometry(shape, {
    depth: x1 - x0 - bevel * 2, bevelEnabled: bevel > 0, bevelThickness: bevel, bevelSize: bevel, bevelOffset: -bevel,
    bevelSegments: 4, curveSegments: 10,
  });
  g.rotateY(Math.PI / 2);
  g.translate(x0 + bevel, 0, 0);
  return g;
}

// the measuring lines for "dimensions": overall width, depth, height and height to the antenna tip,
// plus smaller, lighter ones for each part: the head, the body and its two pieces, the face, the ears and the 5 mm wall.
// The numbers come from the settings above, so they stay right if the robot changes size.
// Each one fades out when it's round the far side of the robot, so labels never show through it.
function buildDims() {
  const group = new THREE.Group();
  const dims: { side: THREE.Vector3; line: THREE.LineBasicMaterial; label: THREE.SpriteMaterial }[] = [];
  const v = (x: number, y: number, z: number) => new THREE.Vector3(x, y, z);
  // one measurement: a line from p0 to p1 with arrows at both ends, lines out from the model (e0, e1) to each end,
  // and a label in the middle. side = which way it faces (it shows when you look from that side).
  // small = one of the lighter measurements of a single part
  const dim = (p0: THREE.Vector3, p1: THREE.Vector3, e0: THREE.Vector3, e1: THREE.Vector3, mm: number, side: THREE.Vector3, small = false) => {
    const pts: THREE.Vector3[] = [], k = small ? 0.7 : 1;
    const u = p1.clone().sub(p0).normalize();
    for (const [p, e, d] of [[p0, e0, 1], [p1, e1, -1]] as const) {
      const out = p.clone().sub(e).normalize();
      pts.push(e.clone().addScaledVector(out, 2), p.clone().addScaledVector(out, 4 * k)); // the line out from the model
      for (const sd of [1, -1]) pts.push(p.clone(), p.clone().addScaledVector(u, 6 * k * d).addScaledVector(out, 2.2 * k * sd)); // arrow
    }
    pts.push(p0.clone(), p1.clone());
    const line = new THREE.LineBasicMaterial({ color: small ? DIM_DETAIL_COLOUR : DIM_COLOUR, transparent: true, opacity: 0 });
    group.add(new THREE.LineSegments(new THREE.BufferGeometry().setFromPoints(pts), line));
    // the label: the size in mm on a white tag, always facing you
    const c = document.createElement("canvas");
    c.width = 256; c.height = 96;
    const ctx = c.getContext("2d");
    if (ctx) {
      ctx.fillStyle = "#ffffff";
      ctx.beginPath(); ctx.roundRect(8, 14, 240, 68, 34); ctx.fill();
      ctx.fillStyle = small ? DIM_DETAIL_LABEL : DIM_LABEL;
      ctx.font = "600 44px ui-sans-serif, system-ui, sans-serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText(`${Math.round(mm)} mm`, 128, 50);
    }
    const tex = new THREE.CanvasTexture(c);
    tex.colorSpace = THREE.SRGBColorSpace;
    const label = new THREE.SpriteMaterial({ map: tex, transparent: true, opacity: 0, depthTest: false, toneMapped: false });
    const tag = new THREE.Sprite(label);
    tag.scale.set(30 * k, 11.25 * k, 1);
    tag.position.copy(p0).add(p1).multiplyScalar(0.5);
    tag.renderOrder = 10;
    group.add(tag);
    dims.push({ side, line, label });
  };
  const FRONT = v(0, 0, 1), RIGHT = v(1, 0, 0), LEFT = v(-1, 0, 0);
  const W = HEAD.hw + 3.7;            // the outside of the ears
  const TIP = HEAD.y1 + 18.5;         // the top of the antenna's ball
  const y = 0.3;                      // just above the desk
  // overall
  dim(v(-W, y, 64), v(W, y, 64), v(-W, y, 8), v(W, y, 8), W * 2, FRONT);                                                       // width, in front
  dim(v(W + 20, y, HEAD.z0), v(W + 20, y, HEAD.z1), v(HEAD.hw, y, HEAD.z0), v(HEAD.hw, y, HEAD.z1), HEAD.z1 - HEAD.z0, RIGHT); // depth, at the side
  dim(v(-W - 26, 0, 0), v(-W - 26, HEAD.y1, 0), v(-BODY.hw - 4, 0, 0), v(-HEAD.hw * 0.5, HEAD.y1, 0), HEAD.y1, LEFT);         // height, on the left
  dim(v(W + 26, 0, -4), v(W + 26, TIP, -4), v(BODY.hw + 8, 0, -4), v(6, TIP, -4), TIP, RIGHT);                                 // to the antenna tip, on the right
  // each part. F = the front of the head, B = the front of the body
  const F = HEAD.z1, B = BODY.z1, R = HEAD.hw + 9; // R: the line down the right of the front, for the head and body heights
  dim(v(-HEAD.hw, HEAD.y1 + 9, F), v(HEAD.hw, HEAD.y1 + 9, F), v(-HEAD.hw + 3, HEAD.y1 - 6, F), v(HEAD.hw - 3, HEAD.y1 - 6, F), HEAD.hw * 2, FRONT, true); // head width, above it
  dim(v(R, HEAD.y0, F), v(R, HEAD.y1, F), v(HEAD.hw - 4, HEAD.y0 + 3, F), v(HEAD.hw - 4, HEAD.y1 - 3, F), HEAD.y1 - HEAD.y0, FRONT, true);              // head height
  dim(v(R, BODY.y0, B), v(R, BODY.y1, B), v(BODY.hw - 4, BODY.y0 + 3, B), v(BODY.hw - 4, BODY.y1 - 3, B), BODY.y1 - BODY.y0, FRONT, true);              // body height
  dim(v(-BODY.hw, 36, B + 9), v(BODY.hw, 36, B + 9), v(-BODY.hw + 2, 36, B - 2), v(BODY.hw - 2, 36, B - 2), BODY.hw * 2, FRONT, true);                // body width, in front of it
  const by = BODY.y1 - 2, bx = BODY.hw + 14; // body depth: along its right side, just under the head and above the arm
  dim(v(bx, by, BODY.z0), v(bx, by, BODY.z1), v(BODY.hw - 4, by, BODY.z0), v(BODY.hw - 4, by, BODY.z1), BODY.z1 - BODY.z0, RIGHT, true);
  dim(v(-27, FACE_Y + 23, F + 1), v(27, FACE_Y + 23, F + 1), v(-24, FACE_Y + 15, F + 1), v(24, FACE_Y + 15, F + 1), 54, FRONT, true);                                 // the face panel's width
  dim(v(-35, FACE_Y - 17, F + 1), v(-35, FACE_Y + 17, F + 1), v(-26, FACE_Y - 15, F + 1), v(-26, FACE_Y + 15, F + 1), 34, FRONT, true);                               // and its height
  const BACK = v(0, 0, -1), L = -(BODY.hw + 9);
  dim(v(L, BODY.y0, B), v(L, BODY.split, B), v(-BODY.hw + 4, BODY.y0 + 3, B), v(-BODY.hw + 4, BODY.split, B), BODY.split - BODY.y0, FRONT, true); // battery base height
  dim(v(L, BODY.split, B), v(L, BODY.y1, B), v(-BODY.hw + 4, BODY.split, B), v(-BODY.hw + 4, BODY.y1 - 3, B), BODY.y1 - BODY.split, FRONT, true); // upper body height
  dim(v(-30, HEAD.y1 + 8, HEAD.z0), v(-30, HEAD.y1 + 8, HEAD.z0 + WALL), v(-30, HEAD.y1 - 3, HEAD.z0), v(-30, HEAD.y1 - 3, HEAD.z0 + WALL), WALL, BACK, true); // the wall: the back cover's thickness
  const ex = -W - 0.5, ez = EAR.z - EAR.r - 8;
  dim(v(ex, EAR.y - EAR.r, ez), v(ex, EAR.y + EAR.r, ez), v(ex, EAR.y - EAR.r, EAR.z), v(ex, EAR.y + EAR.r, EAR.z), EAR.r * 2, LEFT, true);          // the left ear, across
  group.visible = false;
  return { group, dims };
}

// builds the whole robot. Returns the model plus the bits the page animates
function buildRobot() {
  const root = new THREE.Group();
  const ghostMats: THREE.MeshStandardMaterial[] = []; // the body's materials: these fade in x-ray view
  const ghost = (m: THREE.MeshStandardMaterial) => { ghostMats.push(m); return m; };
  const lineMat = new THREE.LineBasicMaterial({ color: XRAY_LINES, transparent: true, opacity: 0 });
  const lines = new THREE.Group();
  root.add(lines);

  // a named part: hovering any piece of it shows its name
  const part = (label: string, parent: THREE.Object3D, ...objs: THREE.Object3D[]) => {
    const g = new THREE.Group();
    g.userData.label = label;
    objs.forEach((o) => g.add(o));
    parent.add(g);
    return g;
  };
  const asGhost = (m: THREE.Mesh) => { m.userData.ghost = true; return m; };
  const outline = (m: THREE.Mesh, angle = 30) => {
    const l = new THREE.LineSegments(new THREE.EdgesGeometry(m.geometry, angle), lineMat);
    l.position.copy(m.position); l.rotation.copy(m.rotation); l.scale.copy(m.scale);
    lines.add(l);
    return m;
  };

  const M = {
    shell: ghost(std(SHELL_COLOUR, 0.48)),
    base: ghost(std(BASE_COLOUR, 0.55)),
    holder: ghost(std(0x18191c, 0.6)),
    frame: ghost(std(0xdadad6, 0.6)),
    visor: ghost(std(0x08090b, 0.8, 0, { envMapIntensity: 0.15 })),
    accent: std(ACCENT_COLOUR, 0.4),
    dark: std(DARK_COLOUR, 0.55),
    hub: std(0xe9e9e6, 0.5),
    steel: std(0xc9cbd0, 0.32, 1),
    brass: std(0xb8963f, 0.38, 1),
    chip: std(0x111214, 0.5),
    gold: std(0xd0aa4a, 0.35, 1),
    white: std(0xeeeeea, 0.6),
    pico: std(0x1d6b3c, 0.55),
    boardBlack: std(0x17181b, 0.55),
    boardBlue: std(0x1b3f96, 0.5),
    boardGreen: std(0x0f5a45, 0.55),
    battery: std(0xb4b7be, 0.35, 0.7),
    tape: std(0xd9a514, 0.6),
    servo: std(0x2e6fe2, 0.35),
    redLine: std(0xd23a32, 0.5),
    cone: std(0x45474d, 0.7),
    glass: std(0x06070a, 0.08, 0, { envMapIntensity: 1.5 }),
  };

  // everything that wobbles when it's shaken goes in "body" (the shadow on the desk stays put)
  const body = new THREE.Group();
  root.add(body);

  // a rounded block, drawn from the side (z, y) and pushed out sideways, used for the head and the body.
  // r = how round each corner is from the side: [back bottom, front bottom, front top, back top]. edge = how soft its left and right edges are
  const roundBlock = (hw: number, y0: number, y1: number, z0: number, z1: number, r: number[], edge: number, mat: THREE.Material) =>
    new THREE.Mesh(extrudeAcross([[z0, y0, r[0]], [z1, y0, r[1]], [z1, y1, r[2]], [z0, y1, r[3]]], -hw, hw, 0, edge), mat);
  const S = 0;                                    // a sharp corner, where two printed pieces meet
  const hEdge = 7, bEdge = Math.min(8, BODY.round * 0.45);

  // ---------- the printed shells, all WALL (5 mm) thick ----------
  // each shell is drawn as one smooth block, with a thin dark line where its two printed pieces meet
  const seamMat = ghost(std(0x9d9d98, 0.7));
  // the head: the front shell (face, top, bottom, sides and both ears in one print, open at the back) and the back cover, WALL thick
  const head = asGhost(roundBlock(HEAD.hw, HEAD.y0, HEAD.y1, HEAD.z0, HEAD.z1, [6, HEAD.round, HEAD.round, 6], hEdge, M.shell));
  part("head (printed, 5 mm walls): a front shell with the face and ears, and a back cover. 2 screws on each side of the head hold the cover on. take it off to reach the breadboard, the pico, the buzzer and the wires", body, outline(head, 24));
  const headSeam = asGhost(roundBlock(HEAD.hw, HEAD.y0, HEAD.y1, -10, 10, [S, S, S, S], hEdge, seamMat));
  headSeam.scale.set(1.003, 1.003, 0.03);
  headSeam.position.set(0, -(HEAD.y0 + HEAD.y1) / 2 * 0.003, HEAD.z0 + WALL);
  part("the join between the head's front shell and its back cover", body, headSeam);
  // the body: the upper body (with the neck) on top of the battery base (with the feet)
  const torso = asGhost(roundBlock(BODY.hw, BODY.y0, BODY.y1, BODY.z0, BODY.z1, [BODY.round, BODY.round, BODY.round, BODY.round], bEdge, M.shell));
  part("body (printed, 5 mm walls): the upper body with the motion sensor's shelf, on top of the battery base. 2 screws at the back hold them together", body, outline(torso, 24));
  const bodySeam = asGhost(roundBlock(BODY.hw, -10, 10, BODY.z0, BODY.z1, [S, S, S, S], bEdge, seamMat));
  bodySeam.scale.set(1.003, 0.03, 1.003);
  bodySeam.position.set(0, BODY.split, 0);
  part("the join between the upper body and the battery base", body, bodySeam);
  // in x-ray, fine lines show the inside of the walls, so you can see they're 5 mm thick
  outline(roundBlock(HEAD.hw - WALL, HEAD.y0 + WALL, HEAD.y1 - WALL, HEAD.z0 + WALL, HEAD.z1 - WALL, [S, HEAD.round - WALL, HEAD.round - WALL, S], hEdge - 3, M.shell), 24);
  outline(roundBlock(BODY.hw - WALL, BODY.y0 + WALL, BODY.y1 - WALL, BODY.z0 + WALL, BODY.z1 - WALL, [BODY.round - WALL, BODY.round - WALL, BODY.round - WALL, BODY.round - WALL], bEdge - 2, M.shell), 24);
  part("neck (printed with the upper body): hollow, so the wires run up it. it twists into a socket in the head with a quarter-turn lock", body, asGhost(cylY(NECK.r, NECK.y0, NECK.y1, 0, 0, M.base, 40)));

  // ---------- the screws: six m4 x 16 mm flat head, countersunk so their heads sit flush ----------
  // tabs are see-through, so in x-ray you can see the nut and the screw inside each one
  const tabMat = std(0xdfe3ea, 0.5, 0, { transparent: true, opacity: 0.5, depthWrite: false });
  // a nut. along = which way its hole points. Its flats always face up and down
  const nut = (x: number, y: number, z: number, along: "x" | "z") => {
    const m = new THREE.Mesh(new THREE.CylinderGeometry(SCREW.nut, SCREW.nut, SCREW.nutT, 6, 1, false, along === "z" ? Math.PI / 2 : 0), M.chip);
    if (along === "x") m.rotation.z = Math.PI / 2; else m.rotation.x = Math.PI / 2;
    m.position.set(x, y, z);
    return m;
  };
  // 4 in the sides of the head (2 each side), going in along x through the side wall into the tabs on the back cover
  const headScrews: THREE.Object3D[] = [], headTabs: THREE.Object3D[] = [];
  for (const sx of [1, -1]) for (const y of HEAD_TAB.ys) {
    const z = HEAD_TAB.screwZ, out = sx * HEAD.hw;
    headScrews.push(cylX(SCREW.head, out - sx * 0.05, out + sx * 0.15, y, z, M.steel, 24), bx(out + sx * 0.1, out + sx * 0.2, y - 1, y + 1, z - 1, z + 1, M.chip),
      cylX(SCREW.r, out, out - sx * SCREW.len, y, z, M.steel, 12),
      nut(sx * (HEAD_TAB.nutX + SCREW.nutT / 2), y, z, "x"));
    headTabs.push(bx(sx * HEAD_TAB.x0, sx * (HEAD.hw - WALL), y - HEAD_TAB.h / 2, y + HEAD_TAB.h / 2, HEAD_TAB.z0, HEAD_TAB.z1, tabMat));
  }
  part("4 m4 x 16 mm flat head screws: 2 in each side of the head, flush with it. they go through the side wall into the tabs on the back cover", body, ...headScrews);
  part("tabs (printed with the back cover): reach forward into the head, against the side walls. each has a slot in its top that an m4 nut drops into", body, ...headTabs);
  // 2 through the back wall of the battery base, each into a nut in a tab that hangs down from the upper body.
  // a lip on the front of the upper body hooks inside the base, so these two are all it needs
  const baseScrews: THREE.Object3D[] = [], tabs: THREE.Object3D[] = [];
  for (const x of BASE_TAB.xs) {
    const y = BASE_TAB.y;
    baseScrews.push(cylZ(SCREW.head, BODY.z0 - 0.15, BODY.z0 + 0.05, x, y, M.steel, 24), bx(x - 1, x + 1, y - 1, y + 1, BODY.z0 - 0.2, BODY.z0 - 0.1, M.chip),
      cylZ(SCREW.r, BODY.z0, BODY.z0 + SCREW.len, x, y, M.steel, 12),
      nut(x, y, BASE_TAB.nutZ + SCREW.nutT / 2, "z"));
    tabs.push(bx(x - BASE_TAB.hw, x + BASE_TAB.hw, BASE_TAB.y0, BASE_TAB.y1, BASE_TAB.z0, BASE_TAB.z1, tabMat));
  }
  tabs.push(bx(-20, 20, 22, BASE_TAB.y1, BODY.z1 - WALL - 2.5, BODY.z1 - WALL, M.hub)); // the lip at the front, fused into the front wall the same way
  part("2 m4 x 16 mm flat head screws: in the back of the battery base, flush with it. undo these to change the batteries", body, ...baseScrews);
  part("tabs (printed with the upper body): hang down inside the battery base. the back two each hold an m4 nut, pushed in from the front. the front one is a lip that hooks in", body, ...tabs);
  // two little feet, and two stubby arms
  for (const sx of [1, -1]) {
    const foot = new THREE.Mesh(new THREE.SphereGeometry(1, 32, 20), M.base);
    foot.scale.set(13, 8, 19);
    foot.position.set(sx * 18, 8, 18);
    part("foot (printed with the battery base)", body, asGhost(foot));
    const arm = new THREE.Mesh(new THREE.CapsuleGeometry(6.5, 16, 8, 20), M.shell);
    arm.position.set(sx * (BODY.hw + 4), 29, 2);
    arm.rotation.z = sx * 0.32;
    part("arm (printed separately, glued into a hole)", body, asGhost(arm));
  }
  // a little antenna on top
  part("antenna (printed separately and glued in, just for looks)", body, cylY(1.6, HEAD.y1 - 2, HEAD.y1 + 11, 0, -4, M.base, 16),
    (() => { const b = new THREE.Mesh(new THREE.SphereGeometry(4.5, 24, 16), M.accent); b.position.set(0, HEAD.y1 + 14, -4); return b; })());
  const USB_Z = BOARD.z0 - 4.85, BUZZ_Z = -16.5; // where the pico's usb connector and the buzzer sit, front to back
  // round ears. The left one has the pico's usb port in it; the right one is a grille for the buzzer
  for (const sx of [1, -1]) {
    const ear = cylX(EAR.r, sx * HEAD.hw - sx * 0.5, sx * (HEAD.hw + 3.5), EAR.y, EAR.z, M.base, 48);
    const ring = cylX(EAR.r - 3, sx * (HEAD.hw + 3.4), sx * (HEAD.hw + 3.7), EAR.y, EAR.z, M.accent, 48);
    part(sx < 0 ? "left ear: a 13 x 9 mm hole through it and the wall lets the usb cable's whole plug reach the pico" : "right ear: a grille for the buzzer", body, ear, ring);
  }
  // the usb hole: 13 x 9 mm, lined up with the pico's connector, big enough for the plastic body of the cable's plug
  part("usb hole (13 x 9 mm): code and power go in here", body, bx(-HEAD.hw - 3.8, -HEAD.hw - 3.4, EAR.y - 4.5, EAR.y + 4.5, USB_Z - 6.5, USB_Z + 6.5, M.chip));
  const holes: THREE.Object3D[] = [];
  for (const [dy, dz] of [[0, 0], [5, 0], [-5, 0], [2.5, 4.3], [-2.5, 4.3], [2.5, -4.3], [-2.5, -4.3]]) holes.push(cylX(1.1, HEAD.hw + 3.6, HEAD.hw + 3.8, EAR.y + dy, BUZZ_Z + dz, M.chip, 16));
  part("grille for the buzzer", body, ...holes);
  // blue cheeks
  for (const sx of [1, -1]) {
    const cheek = new THREE.Mesh(new THREE.CircleGeometry(4.2, 32), M.accent);
    cheek.position.set(sx * 35, FACE_Y - 14, HEAD.z1 + 0.06);
    body.add(cheek);
  }

  // ---------- the face: a dark panel on the front of the head, with the oled behind a window in it ----------
  const face = new THREE.Group();
  face.position.set(0, FACE_Y, HEAD.z1);
  body.add(face);
  const eyeCanvas = document.createElement("canvas");
  eyeCanvas.width = 128; eyeCanvas.height = 64;
  const eyeTex = new THREE.CanvasTexture(eyeCanvas);
  eyeTex.magFilter = THREE.NearestFilter;
  eyeTex.colorSpace = THREE.SRGBColorSpace;
  const visorShape = roundedShape([[-27, -17], [27, -17], [27, 17], [-27, 17]], 13);
  const visor = asGhost(new THREE.Mesh(new THREE.ExtrudeGeometry(visorShape, { depth: 1, bevelEnabled: false, curveSegments: 14 }), M.visor));
  visor.position.z = -0.6;
  const screen = new THREE.Mesh(new THREE.PlaneGeometry(21.7, 10.9), new THREE.MeshBasicMaterial({ map: eyeTex, toneMapped: false }));
  screen.position.set(0, 1.5, 0.45);
  part("the face: 0.96 inch oled, 128 x 64 pixels. it sits in a window in the 5 mm front wall, held from behind by a printed clip", face, visor, screen,
    bx(-13, 13, -8, 11, -4, -2.5, M.glass),                   // the display's glass
    bx(-13.5, 13.5, -14.5, 13.5, -5.6, -4, M.boardBlue),      // its board
    bx(-15.5, 15.5, -16.5, 15.5, -10, -5.6, M.holder),        // its case (size estimated: measure yours)
    bx(-5, 5, 10, 12.5, -24, -10, M.chip));                   // the 4 jumper plugs on its pins

  // ---------- inside the head: the breadboard standing upright, with the pico on its back ----------
  const zHoles = BOARD.z0, yMid = (BOARD.y0 + BOARD.y1) / 2;
  const bl = BOARD.x0, br = BOARD.x0 + 85; // the breadboard's left and right edges
  const inX = HEAD.hw - WALL, inY0 = HEAD.y0 + WALL, inY1 = HEAD.y1 - WALL; // the inside of the head's walls
  part("half-size breadboard (85 x 55 mm), standing upright: slides in through the back of the head before the cover goes on", body,
    bx(bl, br, BOARD.y0, BOARD.y1, BOARD.z0, BOARD.z1, M.white),
    bx(bl, br, yMid - 1.2, yMid + 1.2, zHoles - 0.05, zHoles + 0.01, M.chip),
    bx(bl + 2.5, br - 2.5, BOARD.y0 + 2, BOARD.y0 + 2.6, zHoles - 0.05, zHoles + 0.01, M.redLine),
    bx(bl + 2.5, br - 2.5, BOARD.y1 - 2.6, BOARD.y1 - 2, zHoles - 0.05, zHoles + 0.01, M.accent));
  // what holds it: a rib on the left wall in front of it, and a rail on the right (it doesn't reach the right wall)
  part("rib and rail (printed with the head): hold the breadboard. a rib on the left wall, and a rail on the right that its edge slides into", body,
    bx(-inX, bl + 2, inY0, inY1, BOARD.z1, BOARD.z1 + 2, M.hub),
    bx(br + 0.2, br + 2.2, inY0, inY1, BOARD.z0, BOARD.z1 + 2, M.hub),
    bx(br - 2, br + 0.2, inY0, inY1, BOARD.z1, BOARD.z1 + 2, M.hub));
  // 2 posts on the back cover reach forward to just behind the breadboard, so it can't slide back once the cover is on
  part("posts (printed with the back cover): 2 of them reach forward to just behind the breadboard, so it can't slide backwards", body,
    ...STANDOFF.ys.map((y) => bx(bl + STANDOFF.x - STANDOFF.hw, bl + STANDOFF.x + STANDOFF.hw, y - STANDOFF.hw, y + STANDOFF.hw, HEAD.z0 + WALL, BOARD.z0 - STANDOFF.gap, M.hub)));
  const pz = zHoles - 2.5; // the pico's board, standing off the breadboard on its header strips
  part("raspberry pi pico 2 w with header (51 x 21 mm): the brain, with wi-fi. its usb connector is flush with the left wall", body,
    bx(bl, bl + 51, yMid - 10, yMid - 7.5, pz, zHoles, M.chip),
    bx(bl, bl + 51, yMid + 7.5, yMid + 10, pz, zHoles, M.chip),
    bx(bl, bl + 51, yMid - 10.5, yMid + 10.5, pz - 1, pz, M.pico),
    bx(bl - 1.5, bl + 4.2, yMid - 4, yMid + 4, pz - 3.7, pz - 1, M.steel),   // usb, flush with the inside of the left wall
    bx(bl + 18.5, bl + 25.5, yMid - 3.5, yMid + 3.5, pz - 1.9, pz - 1, M.chip),  // the rp2350 chip
    bx(bl + 36.5, bl + 48.5, yMid - 5.5, yMid + 5.5, pz - 2.8, pz - 1, M.steel),    // the wireless module's shield
    bx(bl + 6.5, bl + 9.5, yMid + 5.5, yMid + 8, pz - 2.1, pz - 1, M.white));  // the bootsel button
  const plugs: THREE.Object3D[] = [];
  const plugAt = (x: number, y: number, mat: THREE.Material) => plugs.push(bx(bl + x - 1.25, bl + x + 1.25, y - 1.25, y + 1.25, zHoles - 14, zHoles, mat)); // x = how far from the board's left edge
  // the 4 signal wires (oled and motion sensor) go in the free holes right under the pico's pins 1, 2, 4 and 5.
  // that's 3.25 mm above the cover's lower left tab, with nothing behind them, so the wires have room to bend
  const sigY = yMid - 13.97;
  plugAt(1.4, sigY, M.redLine); plugAt(3.94, sigY, M.dark); plugAt(9.02, sigY, M.accent); plugAt(11.56, sigY, M.tape);
  plugAt(54.5, yMid - 6, M.redLine); plugAt(57, yMid - 6, M.dark); plugAt(59.5, yMid + 6, M.accent); plugAt(62, yMid + 6, M.tape);
  plugAt(81.5, BOARD.y0 + 2.3, M.redLine); plugAt(81.5, BOARD.y1 - 2.3, M.dark);
  part("jumper wires: plug every part into the breadboard, no soldering", body, ...plugs);
  part("passive buzzer brick (19 x 27 mm): chirps, chimes and alarms. it sits against the right wall, behind the right ear's grille", body,
    bx(inX - 10.6, inX - 9, EAR.y - 13.5, EAR.y + 13.5, BUZZ_Z - 9.5, BUZZ_Z + 9.5, M.boardBlack),
    cylX(6, inX - 9, inX, EAR.y, BUZZ_Z, M.chip),
    bx(inX - 16.5, inX - 10.6, EAR.y - 12.5, EAR.y - 9.5, BUZZ_Z - 4, BUZZ_Z + 4, M.white));

  // ---------- inside the body: the batteries, the motion sensor and the diode ----------
  const cells: THREE.Object3D[] = [];
  for (const z of [-12.2, 0, 12.2]) cells.push(cylX(5.25, -22.2, 22.2, 16, z, M.battery, 24), cylX(2, 22.2, 23.4, 16, z, M.gold, 12));
  part("3 aaa batteries (about 3.6 to 4.5 v)", body, ...cells);
  part("battery holder (63.5 x 36.8 x 15.7 mm): sits loose in a pocket in the battery base, its switch facing down", body,
    outline(asGhost(bx(-31.75, 31.75, 8.2, 23.9, -18.4, 18.4, M.holder))),
    bx(-4, 4, 7.4, 8.2, -10, -2, M.chip));
  // the on/off switch: the floor is thinned to 1.5 mm in a pocket under it, so its knob shows on the outside, between the feet
  part("on/off switch: the battery holder's own switch. it pokes through a slot in a pocket under the body, so you flip it from outside", body,
    bx(-1.5, 1.5, 3.6, 7.4, -8, -4, M.accent),
    bx(-7, 7, BODY.y0 - 0.12, BODY.y0 - 0.02, -13, 1, M.chip));
  part("shelf (printed with the upper body): the motion sensor screws onto it", body, bx(-BODY.hw + WALL, BODY.hw - WALL, 30, 31.5, -15, 4, M.hub));
  part("mpu6050 motion sensor (about 21 x 16 mm): feels being picked up and shaken. its wires go straight up the neck", body,
    bx(-10.5, 10.5, 31.5, 33, -14, 2, M.boardBlue), bx(-2, 2, 33, 33.9, -8, -4, M.chip),
    bx(-10.5, 10.5, 33, 35.5, -0.5, 2, M.chip),
    bx(-5, -2.5, 35.5, 49.5, -0.5, 2, M.redLine), bx(-2.5, 0, 35.5, 49.5, -0.5, 2, M.dark), bx(0, 2.5, 35.5, 49.5, -0.5, 2, M.accent), bx(2.5, 5, 35.5, 49.5, -0.5, 2, M.tape));
  part("1n4001 diode: stops usb power flowing back into the batteries", body,
    cylX(1.3, 14, 19.5, 34.5, -12, M.chip, 16), bx(18.4, 19.2, 33.2, 35.8, -13.3, -10.7, M.steel));

  // the soft shadow on the desk
  const sc = document.createElement("canvas");
  sc.width = sc.height = 256;
  const sctx = sc.getContext("2d");
  if (sctx) {
    const g = sctx.createRadialGradient(128, 128, 10, 128, 128, 126);
    g.addColorStop(0, "rgba(0,0,0,0.34)"); g.addColorStop(0.55, "rgba(0,0,0,0.13)"); g.addColorStop(1, "rgba(0,0,0,0)");
    sctx.fillStyle = g; sctx.fillRect(0, 0, 256, 256);
  }
  const shadowTex = new THREE.CanvasTexture(sc);
  const shadow = new THREE.Mesh(new THREE.PlaneGeometry(200, 200), new THREE.MeshBasicMaterial({ map: shadowTex, transparent: true, depthWrite: false, toneMapped: false }));
  shadow.rotation.x = -Math.PI / 2;
  shadow.position.set(0, 0.05, 1);
  root.add(shadow);

  return { root, body, ghostMats, lineMat, eyeCanvas, eyeTex, shadow };
}

// draws the oled. open = 1 wide open, 0 shut. look = -1 left to 1 right. dizzy = spirals for eyes.
function drawEyes(c: HTMLCanvasElement, open: number, look: number, dizzy: number) {
  const ctx = c.getContext("2d");
  if (!ctx) return;
  ctx.fillStyle = "#000";
  ctx.fillRect(0, 0, 128, 64);
  ctx.fillStyle = ctx.strokeStyle = EYE_COLOUR;
  if (dizzy >= 0) { // two spirals, turning
    ctx.lineWidth = 3;
    for (const cx of [38, 90]) {
      ctx.beginPath();
      for (let a = 0; a < Math.PI * 6; a += 0.2) {
        const r = 1 + a * 1.15, x = cx + Math.cos(a + dizzy) * r, y = 32 + Math.sin(a + dizzy) * r;
        if (a === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
    return;
  }
  const h = Math.max(4, 34 * open), w = 24, y = 32 - h / 2, dx = Math.round(look * 9);
  for (const cx of [38, 90]) {
    ctx.beginPath();
    ctx.roundRect(cx - w / 2 + dx, y, w, h, Math.min(8, h / 2));
    ctx.fill();
  }
}

export default function RobotViewer() {
  const wrapRef = useRef<HTMLDivElement>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const [xray, setXray] = useState(false);
  const [spin, setSpin] = useState(true);
  const [dims, setDims] = useState(false);
  const [label, setLabel] = useState<{ text: string; x: number; y: number } | null>(null);
  const xrayRef = useRef(false), spinRef = useRef(true), dimsRef = useRef(false), shakeRef = useRef(-1);

  useEffect(() => {
    const wrap = wrapRef.current, canvas = canvasRef.current;
    if (!wrap || !canvas) return;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setClearColor(0x000000, 0);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    const scene = new THREE.Scene();
    const pm = new THREE.PMREMGenerator(renderer);
    const room = new RoomEnvironment();
    const env = pm.fromScene(room, 0.04).texture;
    scene.environment = env;
    scene.environmentIntensity = 0.85;
    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(-120, 220, 180);
    scene.add(key);

    const robot = buildRobot();
    scene.add(robot.root);
    const measure = buildDims();
    scene.add(measure.group);

    const camera = new THREE.PerspectiveCamera(28, 1, 10, 4000);
    const target = new THREE.Vector3(0, 62, 0);
    camera.position.set(target.x + VIEW_DISTANCE * 0.56, target.y + VIEW_DISTANCE * 0.3, target.z + VIEW_DISTANCE * 0.77);
    const controls = new OrbitControls(camera, canvas);
    controls.target.copy(target);
    controls.enablePan = false;
    controls.enableDamping = true;
    controls.enableZoom = false; // switched on by a click, so scrolling the page past the model doesn't zoom it
    controls.minDistance = 130;
    controls.maxDistance = 700;
    controls.autoRotateSpeed = SPIN_SPEED;
    let dragging = false;
    controls.addEventListener("start", () => { dragging = true; setLabel(null); });
    controls.addEventListener("end", () => { dragging = false; });

    const size = () => {
      const w = wrap.clientWidth, h = wrap.clientHeight;
      if (!w || !h) return;
      renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.fov = w / h < 0.9 ? 28 / Math.max(0.55, w / h) * 0.9 : 28; // step back a little on tall, narrow screens
      camera.updateProjectionMatrix();
    };
    const ro = new ResizeObserver(size);
    ro.observe(wrap);
    size();

    // hovering or tapping a part shows its name
    const ray = new THREE.Raycaster(), ndc = new THREE.Vector2();
    const meshes: THREE.Mesh[] = [];
    robot.root.traverse((o) => { if ((o as THREE.Mesh).isMesh && o !== robot.shadow) meshes.push(o as THREE.Mesh); });
    const pick = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
      ray.setFromCamera(ndc, camera);
      const list = xrayRef.current ? meshes.filter((m) => !m.userData.ghost) : meshes;
      const hit = ray.intersectObjects(list, false)[0];
      let o: THREE.Object3D | null = hit ? hit.object : null;
      while (o && !o.userData.label) o = o.parent;
      const text = o ? (o.userData.label as string) : "";
      if (!text) setLabel(null);
      else setLabel({ text, x: e.clientX - r.left, y: e.clientY - r.top });
    };
    const onMove = (e: PointerEvent) => { if (!dragging && e.pointerType === "mouse") pick(e); };
    const onDown = (e: PointerEvent) => { controls.enableZoom = true; if (e.pointerType !== "mouse") pick(e); };
    const onLeave = () => { controls.enableZoom = false; setLabel(null); };
    canvas.addEventListener("pointermove", onMove);
    canvas.addEventListener("pointerdown", onDown);
    canvas.addEventListener("pointerleave", onLeave);

    const camDir = new THREE.Vector3();
    let raf = 0, last = performance.now(), xr = 0, dm = 0, eyeKey = "", seen = true;
    const io = new IntersectionObserver((en) => { seen = en[0].isIntersecting; });
    io.observe(wrap);
    const tick = (now: number) => {
      raf = requestAnimationFrame(tick);
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (!seen) return;
      // x-ray fades the body out so the parts show through
      const xg = xrayRef.current ? 1 : 0;
      xr += (xg - xr) * (1 - Math.exp(-dt * 7));
      if (Math.abs(xg - xr) < 0.003) xr = xg;
      for (const m of robot.ghostMats) {
        const tr = xr > 0.002;
        if (m.transparent !== tr) { m.transparent = tr; m.needsUpdate = true; } // three needs telling when this flips
        m.opacity = 1 - (1 - XRAY_GHOST) * xr;
        m.depthWrite = xr < 0.5;
      }
      robot.lineMat.opacity = 0.5 * xr;
      robot.shadow.material.opacity = 1 - 0.5 * xr;
      // "dimensions" fades the measuring lines in and out
      const dg = dimsRef.current ? 1 : 0;
      dm += (dg - dm) * (1 - Math.exp(-dt * 7));
      if (Math.abs(dg - dm) < 0.003) dm = dg;
      measure.group.visible = dm > 0;
      if (dm > 0) {
        // each one shows only from its own side: fully from straight on, gone once you're round the back
        camDir.copy(camera.position).sub(controls.target).setY(0).normalize();
        for (const m of measure.dims) {
          const f = Math.min(1, Math.max(0, (m.side.dot(camDir) + 0.05) / 0.35));
          m.line.opacity = m.label.opacity = dm * f;
        }
      }
      // "shake": it wobbles about like it's being shaken, then its eyes go dizzy
      const t = now / 1000;
      if (shakeRef.current === 0) shakeRef.current = t; // just pressed
      const st = shakeRef.current > 0 ? t - shakeRef.current : -1;
      if (st > SHAKE_SECONDS + DIZZY_SECONDS) shakeRef.current = -1;
      const wob = st >= 0 && st < SHAKE_SECONDS ? Math.sin(st * 34) * (1 - st / SHAKE_SECONDS) : 0;
      robot.body.rotation.z = wob * 0.14;
      robot.body.rotation.x = wob * 0.05;
      robot.body.position.y = Math.abs(wob) * 9;
      // the face: blinks every few seconds and glances about; dizzy after a shake
      const b = t % 3.6;
      const open = b < 0.16 ? Math.abs(b - 0.08) / 0.08 : 1;
      const look = Math.round(Math.sin(t * 0.55) * Math.max(0, Math.sin(t * 0.21)) * 4) / 4;
      const dizzy = st >= 0 ? Math.round(t * 8) / 2 : -1;
      const k = `${open.toFixed(1)}|${look}|${dizzy}`;
      if (k !== eyeKey) { eyeKey = k; drawEyes(robot.eyeCanvas, open, look, dizzy); robot.eyeTex.needsUpdate = true; }
      controls.autoRotate = spinRef.current && !dragging;
      controls.update();
      renderer.render(scene, camera);
    };
    raf = requestAnimationFrame(tick);

    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
      canvas.removeEventListener("pointermove", onMove);
      canvas.removeEventListener("pointerdown", onDown);
      canvas.removeEventListener("pointerleave", onLeave);
      controls.dispose();
      [robot.root, measure.group].forEach((g) => g.traverse((o) => {
        const m = o as THREE.Mesh;
        if (m.geometry) m.geometry.dispose();
        const mat = m.material as THREE.Material | THREE.Material[] | undefined;
        (Array.isArray(mat) ? mat : mat ? [mat] : []).forEach((x) => {
          const map = (x as THREE.MeshBasicMaterial).map;
          if (map) map.dispose();
          x.dispose();
        });
      }));
      room.dispose();
      env.dispose();
      pm.dispose();
      renderer.dispose();
    };
  }, []);

  const pill = (on: boolean) =>
    `whitespace-nowrap rounded-full border px-2.5 py-1 text-xs lowercase transition sm:px-4 sm:py-1.5 sm:text-sm ${on ? "border-neutral-900 bg-neutral-900 text-white" : "border-neutral-300 text-neutral-700 hover:border-neutral-500"}`;

  return (
    <div ref={wrapRef} className="relative h-full w-full">
      <canvas ref={canvasRef} role="img" aria-label="A 3D model of the desk robot. Drag to turn it round." className="absolute inset-0 h-full w-full cursor-grab active:cursor-grabbing" />
      {/* the name of the part under the pointer */}
      {label && (
        <div className="pointer-events-none absolute z-10 max-w-[16rem] rounded-md bg-neutral-900 px-3 py-1.5 text-sm lowercase leading-snug text-white shadow-lg" style={{ left: Math.max(8, label.x + 14), top: Math.max(8, label.y + 14) }}>
          {label.text}
        </div>
      )}
      <div className="absolute inset-x-0 bottom-4 flex flex-wrap items-center justify-between gap-3 px-1">
        <span className="hidden text-sm font-light lowercase text-neutral-500 sm:inline">drag to rotate, click then scroll to zoom</span>
        <span className="flex flex-wrap gap-1 sm:gap-2">
          <button type="button" onClick={() => { shakeRef.current = 0; }} className={pill(false)}>shake</button>
          <button type="button" aria-pressed={dims} onClick={() => { dimsRef.current = !dimsRef.current; setDims(dimsRef.current); }} className={pill(dims)}>dimensions</button>
          <button type="button" aria-pressed={xray} onClick={() => { xrayRef.current = !xrayRef.current; setXray(xrayRef.current); }} className={pill(xray)}>x-ray</button>
          <button type="button" aria-pressed={spin} onClick={() => { spinRef.current = !spinRef.current; setSpin(spinRef.current); }} className={pill(spin)}>spin</button>
        </span>
      </div>
    </div>
  );
}
